{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/honey-session.js\"",
            "timeout": 5,
            "statusMessage": "Loading honey mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/honey-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading honey mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/logcompress-hook.js\"",
            "timeout": 10,
            "statusMessage": "Compressing output..."
          }
        ]
      }
    ]
  }
}
